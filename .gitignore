# Dependencies
/node_modules
/.pnpm-store

# Agent working output (local only)
# Keep .agent/episodes.md tracked (architectural inferences).
/.agent/*
!/.agent/episodes.md
/.agent-cache/

# Command Code local state
# Keep settings.json and taste tracked; other local state stays ignored.
/.commandcode/*
!/.commandcode/settings.json
!/.commandcode/taste/
!/.commandcode/taste/**

# Logs
*.log
pnpm-debug.log*

# OS & editor metadata
.DS_Store
Thumbs.db
